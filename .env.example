# 中转站根地址，不要把 API Key 写在 VITE_ 前缀变量中。
AI_API_BASE_URL=https://xcode.best/v1
AI_API_KEY=replace-with-your-api-key
AI_API_KEY_HEADER=Authorization
AI_API_KEY_PREFIX=Bearer

# 需要支持图片编辑/图生图接口，以便把上传的宠物图片作为 image 传入。
AI_IMAGE_ENDPOINT=/v1/images/edits

# 以下变量会被前端读取，模型名称不是敏感信息。
VITE_AI_IMAGE_MODEL=gpt-image-2.5
VITE_AI_IMAGE_SIZE=1024x1024
